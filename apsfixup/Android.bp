// libapsfixup — runtime corrector for the sm8550 (astonc) APS P010 over-walk SIGSEGV.
// Installs to /odm/lib64 and is pulled into com.oplus.camera as a DT_NEEDED of
// libAlgoProcess.so (added via extract-files.py .add_needed). Fixes the bug purely by GOT
// redirection of the p010LSB2MSB JUMP_SLOT -- no code patching -- so it needs no execmem/execmod.
cc_library_shared {
    name: "libapsfixup",
    srcs: ["apsfixup.cpp"],
    shared_libs: ["liblog"],
    device_specific: true, // -> /odm/lib64
    compile_multilib: "64",
    cppflags: [
        "-std=c++17",
        "-Wall",
        "-Wno-unused-parameter",
        "-fno-exceptions",
        "-fno-rtti",
    ],
    // keep symbols for logcat triage of the GOT-hook install.
    strip: {
        none: true,
    },
}
