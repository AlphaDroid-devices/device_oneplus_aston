# Bypass Charging
# rw: BypassChargingController read-verifies every write to mmi_charging_enable
allow system_app vendor_sysfs_usb_supply:file rw_file_perms;

# Gamebar
allow system_app { proc_stat vendor_sysfs_kgsl vendor_sysfs_kgsl_gpuclk }:file r_file_perms;

# OnePulse PWM / HBM / AOD light mode under /sys/kernel/oplus_display
# (aod_light_mode_set: 0=50 nits, 1=10 nits — written by AodBrightnessController)
rw_dir_file(system_app, vendor_sysfs_graphics);
