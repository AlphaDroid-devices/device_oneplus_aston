# "Show refresh rate" overlay reads the panel test-TE counter (real DDIC
# self-refresh rate) via ro.surface_flinger.panel_refresh_rate_node =
# /sys/kernel/oplus_display/test_te (labelled vendor_sysfs_graphics).
allow surfaceflinger vendor_sysfs_graphics:dir search;
allow surfaceflinger vendor_sysfs_graphics:file r_file_perms;
