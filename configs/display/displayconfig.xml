            <nits>132.21</nits>
        </point>
        <point>
            <value>0.429134</value>
            <nits>206.63</nits>
        </point>
        <point>
            <value>0.507874</value>
            <nits>300.35</nits>
        </point>
        <point>
            <value>0.586614</value>
            <nits>410.38</nits>
        </point>
        <point>
            <value>0.665354</value>
            <nits>541.14</nits>
        </point>
        <point>
            <value>0.744094</value>
            <nits>693.62</nits>
        </point>
        <point>
            <value>0.800000</value>
            <nits>811.12</nits>
        </point>
        <point>
            <value>0.822835</value>
            <nits>900.58</nits>
        </point>
        <point>
            <value>0.881890</value>
            <nits>1131.74</nits>
        </point>
        <point>
            <value>0.940945</value>
            <nits>1362.90</nits>
        </point>
        <point>
            <value>1.000000</value>
            <nits>1594.06</nits>
        </point>
    </screenBrightnessMap>

    <!-- transitionPoint 0.8 = 811 nits = stock OOS normal-mode maximum. Above it:
         sunshine HBM under auto-brightness needs ambient lux >= minimumLux
         (stock hbm_lux_table 31 exits sunshine at 20000 lux; our lux curve only
         requests >811 nits above 40000 lux, which reproduces stock's 40k-enter/
         20k-exit hysteresis). Zeroed timing = no time budget, and keeps the
         manual slider's full 1594-nit range that shipped in 4.6.
         minimumHdrPercentOfScreen 0.5 (AOSP default): HDR boost only when an
         HDR/UltraHDR layer covers at least half the screen, so feed images on
         Instagram/X don't trigger it but fullscreen video does. -->
    <highBrightnessMode enabled="true">
        <transitionPoint>0.8</transitionPoint>
        <minimumLux>20000</minimumLux>
        <timing>
            <timeWindowSecs>0</timeWindowSecs>
            <timeMaxSecs>0</timeMaxSecs>
            <timeMinSecs>0</timeMinSecs>
        </timing>
        <minimumHdrPercentOfScreen>0.5</minimumHdrPercentOfScreen>
        <!-- HDR panel brightness = current SDR nits x ratio, clamped to 1594.
             Tapered so dark-room HDR stays comfortable (4x of a low SDR base)
             and the product stays monotonic up to panel max at the 811-nit
             normal maximum (811 x 1.965 = 1594). -->
        <sdrHdrRatioMap>
            <point>
                <sdrNits>2.0</sdrNits>
                <hdrRatio>4.0</hdrRatio>
            </point>
            <point>
                <sdrNits>100.0</sdrNits>
                <hdrRatio>4.0</hdrRatio>
            </point>
            <point>
                <sdrNits>200.0</sdrNits>
                <hdrRatio>3.4</hdrRatio>
            </point>
            <point>
                <sdrNits>300.0</sdrNits>
                <hdrRatio>3.0</hdrRatio>
            </point>
            <point>
                <sdrNits>500.0</sdrNits>
                <hdrRatio>2.4</hdrRatio>
            </point>
            <point>
                <sdrNits>700.0</sdrNits>
                <hdrRatio>2.1</hdrRatio>
            </point>
            <point>
                <sdrNits>811.12</sdrNits>
                <hdrRatio>1.965</hdrRatio>
            </point>
        </sdrHdrRatioMap>
    </highBrightnessMode>

    <hdrBrightnessConfig>
        <brightnessMap>
            <point>
                <first>100000</first>
                <second>1.0</second>
            </point>
        </brightnessMap>
        <brightnessIncreaseDebounceMillis>4000</brightnessIncreaseDebounceMillis>
        <brightnessDecreaseDebounceMillis>4000</brightnessDecreaseDebounceMillis>
        <screenBrightnessRampIncrease>0.05</screenBrightnessRampIncrease>
        <screenBrightnessRampDecrease>0.05</screenBrightnessRampDecrease>
        <allowInLowPowerMode>false</allowInLowPowerMode>
    </hdrBrightnessConfig>

    <!-- Route auto-brightness to the OPLUS Fusion Light Sensor: the stock
         content-immune android.sensor.light, registered by the fusion ext-port
         (vendor/oneplus/fusion + the frameworks/native libsensorservice patch). It
         subtracts the panel's own emission using the CWB feed (cwb-host), so its
         lux tracks real ambient regardless of on-screen content. This supersedes
         the earlier qti.sensor.bri_light routing (bri_light's CWB compensation was
         structurally inert on aston — see aston-autobrightness.md). Falls back to
         config_displayLightSensorType/default light sensor if absent. -->
    <lightSensor>
        <type>android.sensor.light</type>
        <name>OPLUS Fusion Light Sensor Next Gen</name>
    </lightSensor>

    <!-- Minimum absolute lux change required before auto-brightness reacts,
         mirroring stock ColorOS's under-screen-sensor reaction floor
         (OplusBrightnessAmbientAdapter STABLE_RIGHT_MIN_LUX_UNDER_SCREEN_LIGHT
         = 7.01 large / 4.2 small: changes below it are ignored outright).
         Darkening uses the large floor (7): the engine's stale-CWB transients
         during scrolls produce multi-second hard-0 runs from a ~5 lux base
         (measured amazon.es scroll 2026-07-18) that a smaller minimum passes.
         The fusion sensor's residual content error is ~0.3-5.5 lux at night
         (measured 2026-07-18, balanced white/dark at ~+3 lux, scales with
         panel brightness); without a floor the ABC chases it on the steep
         low-lux curve. Percentage bands still come from the overlay
         (config_ambientBrightening/DarkeningThresholds) - HysteresisLevels
         falls back per-element when no brightnessThresholdPoints are given,
         and applies max(percentage threshold, value +/- minimum). -->
    <ambientBrightnessChangeThresholds>
        <brighteningThresholds>
            <minimum>6</minimum>
        </brighteningThresholds>
        <darkeningThresholds>
            <minimum>7</minimum>
        </darkeningThresholds>
    </ambientBrightnessChangeThresholds>
</displayConfiguration>
